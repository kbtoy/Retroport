<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Character create laid out as Battle for Azeroth's (retroport glue package). Sizes, offsets and
	     texture coordinates are BfA 8.3's CharacterCreate.xml; the at-sign ATLAS / COORDS placeholders are
	     BfA atlas pieces, filled in by the build from UiTextureAtlasMember (3.3.5 has no atlases). -->
	<Script file="CharacterCreate.lua"/>
	<Font name="CharCreateFactionNameLarge" inherits="FactionName_Shadow_Huge" virtual="true">
		<FontHeight>
			<AbsValue val="16"/>
		</FontHeight>
	</Font>
	<Frame name="CharacterCreateTooltip" frameStrata="TOOLTIP" hidden="true" parent="GlueParent" inherits="GlueTooltipTemplate">
		<Scripts>
			<OnLoad>
				GlueTooltip_SetFont(self, CharacterCreateTooltipFont);
				self:SetBackdropBorderColor(1.0, 1.0, 1.0);
				self:SetBackdropColor(0.09, 0.09, 0.19);
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- BfA's CharCreateResizablePanelTemplate: a faction-tinted dark gradient in a metal frame with
	     filigree corners -->
	<Frame name="CharCreatePanelTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentFactionBg">
					<Anchors>
						<Anchor point="TOPLEFT" x="8" y="-10"/>
						<Anchor point="BOTTOMRIGHT" x="-8" y="10"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.75"/>
					<Gradient orientation="VERTICAL">
						<MinColor r="0" g="0" b="0"/>
						<MaxColor r="0.2" g="0" b="0"/>
					</Gradient>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentTopEdge" file="@ATLAS:ui-charactercreate-metalframe-horizontal@">
					<Size x="11" y="11"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="31" y="-6"/>
						<Anchor point="TOPRIGHT" x="-31" y="-6"/>
					</Anchors>
					<TexCoords @COORDS:ui-charactercreate-metalframe-horizontal@/>
				</Texture>
				<Texture name="$parentBottomEdge" file="@ATLAS:ui-charactercreate-metalframe-horizontal@">
					<Size x="11" y="11"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="31" y="6"/>
						<Anchor point="BOTTOMRIGHT" x="-31" y="6"/>
					</Anchors>
					<TexCoords @COORDS:ui-charactercreate-metalframe-horizontal@/>
				</Texture>
				<Texture name="$parentLeftEdge" file="@ATLAS:ui-charactercreate-metalframe-vertical@">
					<Size x="11" y="11"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="6" y="-24"/>
						<Anchor point="BOTTOMLEFT" x="6" y="24"/>
					</Anchors>
					<TexCoords @COORDS:ui-charactercreate-metalframe-vertical@/>
				</Texture>
				<Texture name="$parentRightEdge" file="@ATLAS:ui-charactercreate-metalframe-vertical@">
					<Size x="11" y="11"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-6" y="-24"/>
						<Anchor point="BOTTOMRIGHT" x="-6" y="24"/>
					</Anchors>
					<TexCoords @COORDS:ui-charactercreate-metalframe-vertical@/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentTopLeftCorner" file="@ATLAS:ui-charactercreate-metal-finery-corner@">
					<Size x="56" y="49"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
					<TexCoords @COORDS:ui-charactercreate-metal-finery-corner@/>
				</Texture>
				<Texture name="$parentTopRightCorner" file="@ATLAS:ui-charactercreate-metal-finery-corner@">
					<Size x="56" y="49"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
					<TexCoords @COORDS_H:ui-charactercreate-metal-finery-corner@/>
				</Texture>
				<Texture name="$parentBottomLeftCorner" file="@ATLAS:ui-charactercreate-metal-finery-corner@">
					<Size x="56" y="49"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords @COORDS_V:ui-charactercreate-metal-finery-corner@/>
				</Texture>
				<Texture name="$parentBottomRightCorner" file="@ATLAS:ui-charactercreate-metal-finery-corner@">
					<Size x="56" y="49"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords @COORDS_HV:ui-charactercreate-metal-finery-corner@/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- race button (BfA's CharCreateIconButtonTemplate + CharCreateRaceButtonTemplate), 44 units
	     where BfA's is 50: its 64-pixel icon art stretched soft at 1440p -->
	<CheckButton name="CharCreateRaceButtonTemplate" virtual="true" motionScriptsWhileDisabled="true" hidden="true">
		<Size x="44" y="44"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentShadow" file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk">
					<Size x="60" y="60"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.41601563" right="0.54101563" top="0.53710938" bottom="0.59960938"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentBevelEdge" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Highlights">
					<Size x="44" y="44"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0" right="0.5" top="0.5" bottom="1.0"/>
				</Texture>
				<Texture name="$parentDisableTexture" hidden="true">
					<Size x="44" y="44"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<Color r="0.0" g="0.0" b="0.0" a="0.75"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentNameFrame">
				<Size x="56" y="56"/>
				<Anchors>
					<Anchor point="BOTTOM"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentShadow" file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk">
							<Size x="89" y="49"/>
							<Anchors>
								<Anchor point="BOTTOM" x="2" y="-30"/>
							</Anchors>
							<TexCoords left="0.63476563" right="0.80859375" top="0.43359375" bottom="0.48144531"/>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<FontString name="$parentText" inherits="GlueFontNormalSmall">
							<Size x="90" y="12"/>
							<Anchors>
								<Anchor point="BOTTOM" x="2" y="-10"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnMouseDown>
				if ( self:IsEnabled() ) then
					_G[self:GetName().."BevelEdge"]:SetPoint("CENTER", self, "CENTER", 2, -2);
					_G[self:GetName().."Shadow"]:SetWidth(62);
					_G[self:GetName().."Shadow"]:SetHeight(62);
				end
			</OnMouseDown>
			<OnMouseUp>
				if ( self:IsEnabled() ) then
					_G[self:GetName().."BevelEdge"]:SetPoint("CENTER", self, "CENTER", 0, 0);
					_G[self:GetName().."Shadow"]:SetWidth(60);
					_G[self:GetName().."Shadow"]:SetHeight(60);
				end
			</OnMouseUp>
			<OnClick>
				if ( self.enable ) then
					CharacterRace_OnClick(self, self:GetID());
				else
					self:SetChecked(self:GetID() == CharacterCreate.selectedRace and 1 or nil);
				end
				CharacterCreate_HideTooltip();
			</OnClick>
			<OnEnter>
				CharCreateRaceButton_OnEnter(self);
			</OnEnter>
			<OnLeave>
				CharacterCreate_HideTooltip();
			</OnLeave>
		</Scripts>
		<NormalTexture name="$parentNormalTexture" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Races"/>
		<PushedTexture name="$parentPushedTexture" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Races">
			<Size x="44" y="44"/>
			<Anchors>
				<Anchor point="CENTER" x="2" y="-2"/>
			</Anchors>
		</PushedTexture>
		<HighlightTexture file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk" alphaMode="ADD">
			<Size x="56" y="56"/>
			<Anchors>
				<Anchor point="CENTER" x="1" y="-1"/>
			</Anchors>
			<TexCoords left="0.79296875" right="0.95312500" top="0.08300781" bottom="0.16308594"/>
		</HighlightTexture>
		<CheckedTexture file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk" alphaMode="ADD">
			<Size x="56" y="56"/>
			<Anchors>
				<Anchor point="CENTER" x="1" y="-1"/>
			</Anchors>
			<TexCoords left="0.79296875" right="0.95312500" top="0.00097656" bottom="0.08105469"/>
		</CheckedTexture>
	</CheckButton>

	<!-- class button (BfA's CharCreateClassButtonTemplate) -->
	<CheckButton name="CharCreateClassButtonTemplate" virtual="true" motionScriptsWhileDisabled="true" hidden="true">
		<Size x="40" y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentShadow" file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk">
					<Size x="60" y="60"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.41601563" right="0.54101563" top="0.53710938" bottom="0.59960938"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentDisableTexture" hidden="true">
					<Size x="44" y="44"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<Color r="0.0" g="0.0" b="0.0" a="0.75"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentNameFrame">
				<Size x="64" y="64"/>
				<Anchors>
					<Anchor point="BOTTOM"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentShadow" file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk">
							<Size x="97" y="57"/>
							<Anchors>
								<Anchor point="BOTTOM" x="2" y="-31"/>
							</Anchors>
							<TexCoords left="0.63476563" right="0.80859375" top="0.43359375" bottom="0.48144531"/>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<FontString name="$parentText" inherits="GlueFontNormalSmall">
							<Size x="110" y="12"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-59"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnMouseDown>
				if ( self:IsEnabled() ) then
					_G[self:GetName().."Shadow"]:SetWidth(63);
					_G[self:GetName().."Shadow"]:SetHeight(63);
				end
			</OnMouseDown>
			<OnMouseUp>
				if ( self:IsEnabled() ) then
					_G[self:GetName().."Shadow"]:SetWidth(60);
					_G[self:GetName().."Shadow"]:SetHeight(60);
				end
			</OnMouseUp>
			<OnClick>
				if ( self.enable ) then
					CharacterClass_OnClick(self:GetID());
				else
					self:SetChecked(self:GetID() == CharacterCreate.selectedClass and 1 or nil);
				end
				CharacterCreate_HideTooltip();
			</OnClick>
			<OnEnter>
				CharCreateClassButton_OnEnter(self);
			</OnEnter>
			<OnLeave>
				CharacterCreate_HideTooltip();
			</OnLeave>
		</Scripts>
		<NormalTexture name="$parentNormalTexture" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Classes"/>
		<PushedTexture name="$parentPushedTexture" file="Interface\Glues\CharacterCreate\UI-CharacterCreate-Classes">
			<Size x="44" y="44"/>
			<Anchors>
				<Anchor point="CENTER" x="2" y="-2"/>
			</Anchors>
		</PushedTexture>
		<HighlightTexture file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk" alphaMode="ADD">
			<Size x="56" y="56"/>
			<Anchors>
				<Anchor point="CENTER" x="1" y="-1"/>
			</Anchors>
			<TexCoords left="0.79296875" right="0.95312500" top="0.08300781" bottom="0.16308594"/>
		</HighlightTexture>
		<CheckedTexture file="Interface\Glues\CharacterCreate\UI-CharacterCreatePatchwerk" alphaMode="ADD">
			<Size x="56" y="56"/>
			<Anchors>
				<Anchor point="CENTER" x="1" y="-1"/>
			</Anchors>
			<TexCoords left="0.79296875" right="0.95312500" top="0.00097656" bottom="0.08105469"/>
		</CheckedTexture>
	</CheckButton>

	<!-- gender button (BfA's CharacterCreateGenderButtonTemplate) -->
