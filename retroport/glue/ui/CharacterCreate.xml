	<!-- BfA's CharacterCreateInfoTemplate: a panel with a title bar and scrolling text -->
	<Frame name="CharCreateInfoPanelTemplate" inherits="CharCreatePanelTemplate" virtual="true" hidden="true">
		<Size x="243" y="250"/>
		<Layers>
			<Layer level="BORDER">
				<Texture name="$parentHeaderTex">
					<Size x="10" y="32"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="6" y="-8"/>
						<Anchor point="TOPRIGHT" x="-6" y="-8"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="1"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="$parentTitle" inherits="FactionName_Shadow_Huge" justifyH="LEFT">
					<Size x="190" y="24"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentHeaderTex" x="24" y="-2"/>
					</Anchors>
					<Color r="1" g="1" b="1"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollFrame name="$parentScrollFrame" inherits="GlueScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentHeaderTex" relativePoint="BOTTOMLEFT" x="11" y="-4"/>
					<Anchor point="BOTTOMRIGHT" x="-38" y="24"/>
				</Anchors>
				<Scripts>
					<OnLoad>
						local scrollBar = _G[self:GetName().."ScrollBar"];
						scrollBar:ClearAllPoints();
						scrollBar:SetPoint("TOPLEFT", self, "TOPRIGHT", 11, -6);
						scrollBar:SetPoint("BOTTOMLEFT", self, "BOTTOMRIGHT", 11, 12);
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnLoad>
					<OnScrollRangeChanged>
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnScrollRangeChanged>
				</Scripts>
				<ScrollChild>
					<Frame name="$parentScrollChild">
						<Size x="190" y="10"/>
						<Layers>
							<Layer level="ARTWORK">
								<FontString name="$parentBulletText" inherits="GlueFontNormalSmall" justifyH="LEFT">
									<Size x="190" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" x="0" y="-8"/>
									</Anchors>
								</FontString>
								<FontString name="$parentInfoText" inherits="GlueFontCharacterCreate" justifyH="LEFT">
									<Size x="190" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="$parentBulletText" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
	</Frame>

	<!-- a customization row: BfA's customization button art, its name, and 3.3.5's arrows (BfA picks
	     a style from rendered previews 3.3.5 can't make) -->
	<!-- a row: its text between its arrows, on the banner (no plate: the 3.3.5 one is wider than
	     the banner and taller than a row) -->
	<Frame name="CharCreateCustomizationRowTemplate" virtual="true">
		<Size x="200" y="40"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GlueFontNormal">
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentLeftButton">
				<Size x="32" y="32"/>
				<Anchors>
					<Anchor point="LEFT" x="2" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick>
						CharacterCustomization_Left(self:GetParent():GetID());
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
			<Button name="$parentRightButton">
				<Size x="32" y="32"/>
				<Anchors>
					<Anchor point="RIGHT" x="-2" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick>
						CharacterCustomization_Right(self:GetParent():GetID());
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
	</Frame>

	<ModelFFX name="CharacterCreate" toplevel="true" parent="GlueParent" setAllPoints="true" enableKeyboard="true" hidden="true">
		<Frames>
